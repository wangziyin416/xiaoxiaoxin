<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>小小信</AssemblyName>
    <RootNamespace>XiaoXiaoXin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\index.html" Link="Web\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\styles.css" Link="Web\styles.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\app.js" Link="Web\app.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\pets\default\**\*" Link="Web\assets\pets\default\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
